# Talos machine configuration for the homelab single-node control plane.
# Substitute NODE_IP with the Hetzner server IPv4 (terraform output instance_ip).
# Schema: Talos v1alpha1 MachineConfig
# See: https://docs.siderolabs.com/talos/v1.14/reference/configuration/v1alpha1/config
version: v1alpha1
machine:
  type: controlplane
  install:
    disk: /dev/sda
    image: factory.talos.dev/image/376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba/v1.14.5/hcloud-amd64.raw.xz
  network:
    interfaces:
      - interface: eth0
        dhcp: true
  kubelet:
    extraArgs:
      node-ip: NODE_IP
  ephemeral:
    mount:
      secure: true
  features:
    workloadIsolation: true
cluster:
  controlPlane:
    endpoint: https://NODE_IP:6443
  clusterName: homelab
